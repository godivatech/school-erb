# ==============================================================================
# OXFORD SCHOOL ERP - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Port & Public URL
PORT=3000
NODE_ENV=production
BETTER_AUTH_URL=http://localhost:3000

# Better-Auth Cryptographic Secret (Generate using `openssl rand -hex 32`)
BETTER_AUTH_SECRET=f3b5a1c8d0e7294bbceaa678129e01f568a9df2c19a00832a8f89bc10d29

# PostgreSQL 16 Database Configuration
# Local Docker compose uses: postgresql://postgres:postgres_secure_pass@db:5432/school_erp?sslmode=disable
# Managed Cloud (Neon, Supabase, RDS) format: postgresql://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:postgres_secure_pass@localhost:5432/school_erp

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass
POSTGRES_DB=school_erp

# Background Job Queue (pg-boss connects via DATABASE_URL)
PG_BOSS_SCHEMA=pgboss

# S3 / Cloudflare R2 Document Store (For Student Photos, TC PDFs, Report Cards)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=school-erp-documents
CLOUDFLARE_R2_PUBLIC_URL=https://assets.schoolerp.internal

# Cron Authorization Secret (Secures /api/cron/outbox for background event drainage)
CRON_SECRET=

# Demo Role Switching Guard (Set to true only in staging/demo environments, false in production)
ALLOW_DEMO_SWITCHING=false
